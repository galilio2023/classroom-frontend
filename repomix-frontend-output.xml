        <div className={cn("flex-1", "mr-4")}>
          <div className={cn("font-medium", "text-foreground", "text-sm")}>
            {message}
          </div>
          {description && (
            <div className={cn("text-muted-foreground", "text-sm", "mt-1")}>
              {description}
            </div>
          )}
        </div>
        <Button
