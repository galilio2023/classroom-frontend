        },
        {
          id: "actions",
          size: 50,
          header: () => null,
          cell: ({ row }) => (
            <DataTableRowActions
              resource="departments"
              recordId={row.original.id}
              onEdit={() => edit("departments", row.original.id)}
              onDelete={() => setDeleteTarget(row.original.id)}
              editLabel="Edit Department"
              deleteLabel="Delete Department"
            />
          ),
        },
      ],
      [edit],
    ),
