# --- API Configuration ---
# The base URL of your running backend API (e.g. http://localhost:8000/api)
VITE_API_URL=REPLACE_WITH_BACKEND_API_URL
# Files larger than this (in MB) will trigger a rural resilience warning (Default: 5)
VITE_MAX_SYNC_UPLOAD_SIZE_MB=5

# --- Push Notifications ---
# Public VAPID key for web push notifications
VITE_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY

# --- Rural Resilience & Backoff (Mandate Review #8) ---
VITE_INITIAL_DELAY=5000
VITE_MAX_DELAY=30000
# TUS resumable upload endpoint (e.g. http://localhost:8000/api/upload/resumable)
# ⚠️ NOTE: Server-side MUST support OPTIONS and PATCH methods for TUS to function.
VITE_TUS_ENDPOINT=REPLACE_WITH_TUS_ENDPOINT

# --- Cloudinary ---
# Cloudinary cloud name for media management
VITE_CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME

# --- E2E Testing ---
# Credentials for daily core-journey smoke tests
TEST_TEACHER_EMAIL=REPLACE_WITH_TEACHER_EMAIL
TEST_TEACHER_PASSWORD=REPLACE_WITH_TEACHER_PASSWORD
