# --- API Configuration ---
# The base URL of your running backend API
VITE_API_URL="http://localhost:8000/api"

# --- Authentication Keys (Placeholders) ---
# These keys are used to store tokens in localStorage.
VITE_ACCESS_TOKEN_KEY="access_token"
VITE_REFRESH_TOKEN_KEY="refresh_token"

# --- Cloudinary Configuration (Placeholders) ---
# You will replace these with real values from your Cloudinary dashboard later.
VITE_CLOUDINARY_UPLOAD_URL="https://api.cloudinary.com/v1_1/placeholder/image/upload"
VITE_CLOUDINARY_CLOUD_NAME="placeholder-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="placeholder-preset"
