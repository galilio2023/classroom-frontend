worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # 🚀 PERFORMANCE: Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml;
    gzip_disable "MSIE [1-6]\.";

    # 🛡️ SECURITY: Remove version header
    server_tokens off;

    # 🛡️ SECURITY: Global Security Headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    # 🌍 DYNAMIC CSP: Variables injected via entrypoint.sh
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://res.cloudinary.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ${API_DOMAIN} ${SOCKET_DOMAIN};" always;

    server {
        listen 8080;
        server_name localhost;

        root /usr/share/nginx/html;
        index index.html;

        # 🚀 SPA ROUTING: Redirect all 404s to index.html
        location / {
            try_files $uri $uri/ /index.html;
        }

        # 📦 STATIC CACHING: Cache hashed assets for 1 year
        location /assets {
            expires 1y;
            add_header Cache-Control "public, no-transform";
            # Re-add security headers as add_header is not inherited if defined in location
            add_header X-Frame-Options "DENY" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://res.cloudinary.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ${API_DOMAIN} ${SOCKET_DOMAIN};" always;
        }

        # 🛡️ RESILIENCE: Healthcheck for load balancers
        location /health {
            access_log off;
            return 200 "healthy\n";
        }

        # Error handling
        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
        }
    }
}
